# /etc/ccrawl/recrawl-urls.env
#
# The URL work list, which differs from the domain one in the two ways that
# matter to a crawler: it is fifty times bigger, and it arrives clustered by
# host, so a delay of zero would point the whole pool at one site.

CCRAWL_FROM=urls

CCRAWL_SHARD=0
CCRAWL_SHARDS=3
CCRAWL_SERVER=server1

CCRAWL_WORKERS=256
CCRAWL_WRITERS=4

# Lower than the domain list needs. A URL corpus revisits a host for every page
# it has, so the resolver cache carries most of the lookups and the bound is not
# the thing in the way.
CCRAWL_DNS_LOOKUPS=64

# Not zero, unlike the domain list. Consecutive rows here are the same site, and
# a second between two requests to it is the difference between a crawl and a
# complaint.
CCRAWL_DELAY=1s

# Left at the default. Cutting it was measured on the domain list and did not
# move the rate, because a shorter budget turns slow pages into failures at
# about the rate it saves time. See the domain env file for the numbers.
CCRAWL_TIMEOUT=30s

# How much payload goes into a shard before it is sealed, counted uncompressed.
# It decides how many files land on the hub, not how much memory the run needs:
# a shard does buffer in memory until it is sealed, and 20 MB against 512 MB
# was measured at 1.0 to 1.3 GB resident either way.
CCRAWL_SHARD_SIZE=536870912

CCRAWL_COMMIT_EVERY=4
CCRAWL_WATCH=60s

CCRAWL_EXTRA=
