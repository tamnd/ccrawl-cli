# /etc/ccrawl/recrawl-domains.env
#
# Copy this to each server and change CCRAWL_SHARD and the three tuning numbers.
# install.sh writes it for you on a first install and never overwrites it after
# that, because the tuning is per machine and a deploy should not undo it.

# The work list. domains is open-index/ccrawl-domains, 121M rows, one homepage
# per registered domain.
CCRAWL_FROM=domains

# Which third of the work list this machine takes. server1 is 0, server2 is 1,
# server3 is 2. The partition key is the registered domain, so a site and its
# politeness clock stay on one machine however the fleet is resized.
CCRAWL_SHARD=0
CCRAWL_SHARDS=3

# The name this machine publishes under. It is what keeps three machines'
# shards and ledgers apart on the hub, so it has to be unique in the fleet and
# it has to stay the same across a reinstall.
CCRAWL_SERVER=server1

# Width. The rate is workers times yield over time per page, and yield on this
# corpus is about 55 percent, so workers is the only one of the three that is a
# dial. Resident set scales with workers times writers: 256 by 4 peaked at
# 4.5 GB, and 256 by 1 at 2.7 GB. Set it against the RAM the box actually has.
CCRAWL_WORKERS=256

# Output files open at once. Worth raising only when the run reports the writer
# busy in the high eighties. At four writers the share drops to about a third
# each and the page rate moves by a few percent, so this is headroom rather
# than speed.
CCRAWL_WRITERS=4

# DNS lookups in flight. Every row on a domain corpus is a name nobody has
# looked up yet, so this is a per page cost and not a detail of the fetch.
#
# It is not the ceiling, whatever the peak says. Measured on the live list at
# 256 workers, 32 and 128 gave 19.2 and 19.3 pages a second with the peak
# pegged on the bound in both cases. The peak pegs because there is always
# another name wanting a slot, so it says there is demand and nothing about
# what the queue costs. A peak well under the bound is the useful direction:
# that one means DNS is not the constraint.
CCRAWL_DNS_LOOKUPS=128

# Spacing between two requests to the same host. Zero is right for a domain
# corpus, where consecutive rows are different registered domains and the
# spacing would only ever throttle the machine against itself.
CCRAWL_DELAY=0s

# Budget for one fetch and its retries together.
#
# The obvious move is to cut this, since about 1250 rows in every 20000 time
# out at thirty seconds and that looks like a quarter of the pool held for the
# whole run. It was measured at 30s, 10s and 5s and the rate did not move:
# 27.7, 27.6 and 27.4 pages a second. Each item does get faster, and the
# timeouts nearly triple, so the yield falls by about as much as the item
# gained. A short timeout does not skip slow pages, it turns them into
# failures. Leave it alone.
CCRAWL_TIMEOUT=30s

# Payload per output shard before it rotates, counted uncompressed. Bigger
# shards are better for the reader and worse for the publisher, which cannot
# upload one until it closes. 512 MB is about 20 minutes of a healthy run.
#
# A shard buffers in memory until it is sealed, so this looks like a memory
# dial and is not one. Measured on server2 at 48 workers, 20 MB and 512 MB both
# peaked between 1.0 and 1.3 GB resident, and the smallest setting produced the
# highest peak of the four runs. The rows are compressed as they buffer. The
# memory is on the worker side.
CCRAWL_SHARD_SIZE=536870912

# Shards per commit to the hub, and how often the publisher looks for new ones.
CCRAWL_COMMIT_EVERY=4
CCRAWL_WATCH=60s

# Anything else to pass to recrawl run, unquoted and space separated. Empty is
# the normal state. --robots goes here if a work list ever needs it.
CCRAWL_EXTRA=
